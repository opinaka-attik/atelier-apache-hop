<?xml version="1.0" encoding="UTF-8"?>
<!--
  Module 03 - Jointure + Aggregation
  Concepts : Table Input, Merge Join, Group By, Table Output
  Calcule le CA mensuel par categorie depuis les tables commandes + clients_clean
-->
<pipeline>
  <info>
    <name>03_join_aggregation</name>
    <description>Module 03 - Jointure commandes/clients + agregation CA mensuel par categorie</description>
    <pipeline_type>Normal</pipeline_type>
  </info>

  <transforms>
    <!-- Source 1 : Lire les commandes -->
    <transform>
      <name>Lire commandes</name>
      <type>TableInput</type>
      <description>Lit les commandes livrees depuis Postgres</description>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <connection>hop-postgres</connection>
      <sql>SELECT
  c.id AS commande_id,
  c.client_id,
  c.produit,
  c.categorie,
  c.quantite,
  c.prix_unitaire,
  c.quantite * c.prix_unitaire AS montant,
  c.date_commande,
  TO_CHAR(c.date_commande, 'YYYY-MM') AS mois,
  c.statut
FROM commandes c
WHERE c.statut != 'annule'
ORDER BY c.date_commande</sql>
      <limit>0</limit>
      <lookup/>
      <execute_each_row>N</execute_each_row>
      <variables_active>N</variables_active>
      <lazy_conversion_active>N</lazy_conversion_active>
    </transform>

    <!-- Source 2 : Lire les clients -->
    <transform>
      <name>Lire clients</name>
      <type>TableInput</type>
      <description>Lit les clients depuis clients_clean</description>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <connection>hop-postgres</connection>
      <sql>SELECT id, nom_complet, segment FROM clients_clean ORDER BY id</sql>
      <limit>0</limit>
      <lookup/>
      <execute_each_row>N</execute_each_row>
      <variables_active>N</variables_active>
      <lazy_conversion_active>N</lazy_conversion_active>
    </transform>

    <!-- Jointure commandes + clients -->
    <transform>
      <name>Joindre commandes clients</name>
      <type>MergeJoin</type>
      <description>LEFT JOIN commandes sur clients par client_id = id</description>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <join_type>LEFT OUTER</join_type>
      <keys_1><key>client_id</key></keys_1>
      <keys_2><key>id</key></keys_2>
    </transform>

    <!-- Aggregation CA par mois et categorie -->
    <transform>
      <name>Agreger CA mensuel</name>
      <type>GroupBy</type>
      <description>Calcule CA total + nombre commandes par mois et categorie</description>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <all_rows>N</all_rows>
      <sort_direction>None</sort_direction>
      <prefix>tmp_</prefix>
      <add_linenr>N</add_linenr>
      <linenr_fieldname/>
      <give_back_row>N</give_back_row>
      <group>
        <field><name>mois</name></field>
        <field><name>categorie</name></field>
      </group>
      <fields>
        <field><aggregate>ca_total</aggregate><subject>montant</subject><type>SUM</type><valuefield/><iffullnull>N</iffullnull></field>
        <field><aggregate>nb_commandes</aggregate><subject>commande_id</subject><type>COUNT_ALL</type><valuefield/><iffullnull>N</iffullnull></field>
        <field><aggregate>ca_moyen</aggregate><subject>montant</subject><type>AVERAGE</type><valuefield/><iffullnull>N</iffullnull></field>
      </fields>
    </transform>

    <!-- Ecriture dans kpis_mensuels -->
    <transform>
      <name>Ecrire KPIs</name>
      <type>TableOutput</type>
      <description>Insere les KPIs calcules dans kpis_mensuels</description>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <connection>hop-postgres</connection>
      <schema>public</schema>
      <table>kpis_mensuels</table>
      <commit>100</commit>
      <truncate>Y</truncate>
      <ignore_errors>N</ignore_errors>
      <use_batch>Y</use_batch>
      <specify_fields>Y</specify_fields>
      <fields>
        <field><column_name>mois</column_name><stream_name>mois</stream_name></field>
        <field><column_name>ca_total</column_name><stream_name>ca_total</stream_name></field>
        <field><column_name>nb_commandes</column_name><stream_name>nb_commandes</stream_name></field>
        <field><column_name>ca_moyen</column_name><stream_name>ca_moyen</stream_name></field>
      </fields>
    </transform>

    <!-- Log du resultat -->
    <transform>
      <name>Log resultats</name>
      <type>WriteToLog</type>
      <loglevel>Basic</loglevel>
      <displayHeader>Y</displayHeader>
      <logmessage>KPIs calcules et inseres</logmessage>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <fields/>
    </transform>
  </transforms>

  <order>
    <hop><from>Lire commandes</from><to>Joindre commandes clients</to><enabled>Y</enabled></hop>
    <hop><from>Lire clients</from><to>Joindre commandes clients</to><enabled>Y</enabled></hop>
    <hop><from>Joindre commandes clients</from><to>Agreger CA mensuel</to><enabled>Y</enabled></hop>
    <hop><from>Agreger CA mensuel</from><to>Ecrire KPIs</to><enabled>Y</enabled></hop>
    <hop><from>Ecrire KPIs</from><to>Log resultats</to><enabled>Y</enabled></hop>
  </order>

  <notepads/>
</pipeline>
