<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_incremental_load</name>
    <description>Chargement incrémental avec watermark - charg. uniquement les nouvelles lignes</description>
    <pipeline_type>Normal</pipeline_type>
  </info>
  <transforms>
    <transform>
      <name>Lire watermark</name>
      <type>TableInput</type>
      <connection>postgres_hop</connection>
      <sql>SELECT COALESCE(MAX(updated_at), '1970-01-01') AS last_load FROM commandes_incrementales</sql>
      <limit>0</limit>
      <lazy_conversion_active>N</lazy_conversion_active>
    </transform>
    <transform>
      <name>Lire nouvelles commandes</name>
      <type>TableInput</type>
      <connection>postgres_hop</connection>
      <sql>SELECT id, client_id, montant, statut, updated_at FROM commandes WHERE updated_at > ? ORDER BY updated_at</sql>
      <limit>0</limit>
      <execute_for_each_row>Y</execute_for_each_row>
    </transform>
    <transform>
      <name>Ajouter date_chargement</name>
      <type>GetSystemInfo</type>
      <fields>
        <field>
          <name>date_chargement</name>
          <type>system date (variable)</type>
        </field>
      </fields>
    </transform>
    <transform>
      <name>Upsert PostgreSQL</name>
      <type>InsertUpdate</type>
      <connection>postgres_hop</connection>
      <schema>public</schema>
      <table>commandes_incrementales</table>
      <commit>500</commit>
      <fields>
        <field><stream_name>id</stream_name><table_name>id</table_name><update>N</update><condition>=</condition></field>
        <field><stream_name>client_id</stream_name><table_name>client_id</table_name><update>Y</update><condition>=</condition></field>
        <field><stream_name>montant</stream_name><table_name>montant</table_name><update>Y</update><condition>=</condition></field>
        <field><stream_name>statut</stream_name><table_name>statut</table_name><update>Y</update><condition>=</condition></field>
        <field><stream_name>updated_at</stream_name><table_name>updated_at</table_name><update>Y</update><condition>=</condition></field>
      </fields>
    </transform>
    <transform>
      <name>Log fin chargement</name>
      <type>WriteToLog</type>
      <loglevel>Basic</loglevel>
      <displayHeader>Y</displayHeader>
      <logmessage>Chargement incrémental terminé</logmessage>
      <distribute>Y</distribute>
      <copies>1</copies>
      <partitioning><method>none</method><schema_name/></partitioning>
      <fields/>
    </transform>
  </transforms>
  <order>
    <hop><from>Lire watermark</from><to>Lire nouvelles commandes</to><enabled>Y</enabled></hop>
    <hop><from>Lire nouvelles commandes</from><to>Ajouter date_chargement</to><enabled>Y</enabled></hop>
    <hop><from>Ajouter date_chargement</from><to>Upsert PostgreSQL</to><enabled>Y</enabled></hop>
    <hop><from>Upsert PostgreSQL</from><to>Log fin chargement</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
</pipeline>
